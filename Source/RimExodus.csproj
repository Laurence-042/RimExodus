<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../build/RimWorldReferences.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>RimExodus</RootNamespace>
    <AssemblyName>RimExodus</AssemblyName>
    <LangVersion>preview</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ImplicitUsings>disable</ImplicitUsings>
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>..\$(RimWorldVersion)\Assemblies\</OutputPath>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
    <OutputPath>..\$(RimWorldVersion)\Assemblies\</OutputPath>
    <Optimize>True</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Core/RimExodusMissingFrameworkNotice.cs" />
    <Reference Include="RimExodus.Maps">
      <HintPath>../References/REF/$(RimWorldVersion)/RimExodus.Maps.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireFramework" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('../References/REF/$(RimWorldVersion)/RimExodus.Maps.dll')"
           Text="REF reference missing. Run just build $(RimWorldVersion) to build the sibling framework and fetch its DLL first." />
  </Target>
  <Target Name="CopyVersionContent" AfterTargets="Build" Condition="'$(RimWorldVersion)' == '1.7'">
    <ItemGroup><VersionContent Include="../1.6/**/*" Exclude="../1.6/Assemblies/**/*" /></ItemGroup>
    <Copy SourceFiles="@(VersionContent)" DestinationFiles="@(VersionContent->'../1.7/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
