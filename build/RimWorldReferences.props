<Project>
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net48</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">D:\SteamLibrary\steamapps\common\RimWorld</RimWorldDir>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">D:\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HarmonyPath>
    <DefineConstants Condition="'$(RimWorldVersion)' == '1.7'">$(DefineConstants);RIMWORLD_1_7</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(RimWorldDir)\Waylith.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Vulkan"><HintPath>$(RimWorldDir)\Brutal.Vulkan.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Vulkan.Abstractions"><HintPath>$(RimWorldDir)\Brutal.Vulkan.Abstractions.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Core.Numerics"><HintPath>$(RimWorldDir)\Brutal.Core.Numerics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckRimWorldReferences" BeforeTargets="ResolveReferences" Condition="'$(RimWorldVersion)' == '1.7'">
    <Error Condition="!Exists('$(RimWorldDir)\Assembly-CSharp.dll')" Text="Set RimWorldDir to the RimWorld 1.7 installation directory." />
    <Error Condition="!Exists('$(HarmonyPath)')" Text="Set HarmonyPath to the installed 1.7 Harmony assembly." />
  </Target>
</Project>
