<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    无缝地块口袋地图生成器（阶段4a：真实地形 + 多边形 void 裁切）。
    genSteps 复用原版 MapCommonBase 的地形/岩石/植物/动物序列，使口袋地图按真实 worldTile 特性生成原版地形。

    void 裁切用 RimExodus_SeamlessTile genStep（order=211，Terrain 之后立即、Plants 之前）：
    Terrain(order=210) 跑完后 void genStep 把多边形外格覆写为 void，后续 genStep（Plants/RockChunks/Animals）
    读 terrainGrid 发现 void Impassable 自然不 spawn，ClearThingsOnCells 只需清 RocksFromGrid 的岩石。
    不能用 Postfix patch GenStep_Terrain——原方法内部 WaterBodyTracker NRE 会导致 Postfix 被跳过。

    biome/hilliness/elevation 等 TileInfo 字段不能在 Def 里写死（每个地块不同），
    由 GenerateTileMap 通过 extraInitBeforeContentGen 回调从真实 worldTile 动态注入 pocketTileInfo。
    pocketMapProperties.biome 这里留一个占位（会被回调覆盖）。
  -->
  <MapGeneratorDef>
    <defName>RimExodus_SeamlessTileGenerator</defName>
    <label>seamless tile generator</label>
    <pocketMapProperties>
      <biome>BorealForest</biome>
      <temperature>10</temperature>
    </pocketMapProperties>
    <disableShadows>true</disableShadows>
    <genSteps>
      <li>ElevationFertility</li>
      <li>MutatorPostElevationFertility</li>
      <li>RocksFromGrid</li>
      <li>Terrain</li>
      <li>RimExodus_SeamlessTile</li>
      <li>MutatorPostTerrain</li>
      <li>Roads</li>
      <li>RockChunks</li>
      <li>ScatterRuinsSimple</li>
      <li>SteamGeysers</li>
      <li>FindPlayerStartSpot</li>
      <li>Plants</li>
      <li>Snow</li>
      <li>Animals</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <!--
    Debug dirt/water 诊断生成器（阶段4 连续地形诊断基础设施）。
    只跑 RimExodus_DebugDirtWater（噪声显示器：noise > 阈值 = Soil，否则 = WaterOceanDeep）
    + RimExodus_SeamlessTile（六边形 void 裁切，保留多边形边界）+ Fog。
    绕开 ElevationFertility/Terrain/RocksFromGrid/Plants 等所有原版 genStep，
    输出纯粹的噪声二值图，便于肉眼判断接缝处噪声是否连续。
    noiseGenType 仍生效（切换 SphereNormal/LatLong/DiagnosticRings/Off 显示对应模式噪声）。
    由 MapParent_SeamlessTile.MapGeneratorDef 在 debugDirtWaterMode=true 时返回。
  -->
  <MapGeneratorDef>
    <defName>RimExodus_DebugDirtWaterGenerator</defName>
    <label>debug dirt/water generator</label>
    <disableShadows>true</disableShadows>
    <genSteps>
      <li>RimExodus_DebugDirtWater</li>
      <li>RimExodus_SeamlessTile</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <GenStepDef>
    <defName>RimExodus_SeamlessTile</defName>
    <order>211</order>
    <genStep Class="RimExodus.GenStep_SeamlessTile"/>
  </GenStepDef>

  <GenStepDef>
    <defName>RimExodus_DebugDirtWater</defName>
    <order>0</order>
    <genStep Class="RimExodus.GenStep_DebugDirtWater"/>
  </GenStepDef>

</Defs>
