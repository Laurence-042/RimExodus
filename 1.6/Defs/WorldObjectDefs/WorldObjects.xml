<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <WorldObjectDef>
    <defName>RimExodus_SeamlessTileMap</defName>
    <label>seamless tile map</label>
    <worldObjectClass>RimExodus.MapParent_SeamlessTile</worldObjectClass>
    <!-- 复用原版 Base_Player MapGeneratorDef（与 Gravship 地表降落、远行队扎营定居共用同一条 genStep 链：
         Settlement.MapGeneratorDef override 对玩家派系返回 Base_Player）。
         MapParent_SeamlessTile : MapParent（非 PocketMapParent），IncrementalMapGenerator 走纯基础地图路径，
         从不读 pocketMapProperties，故 Base_Player 无 pocketMapProperties 不影响生成。
         三个 RimExodus genStep（CoastalEdgeFill/SeamlessTile/SeamOverride）由 Patches/MapGeneration.xml
         注入到 Base_Player 链，邻居地块与玩家家园图（原生 parent）走完全相同的链。 -->
    <mapGenerator>Base_Player</mapGenerator>
    <!-- useDynamicDrawer=true：走 WorldDynamicDrawManager 每帧调 Draw()，支持按运行时状态
         （休眠/活跃有人/活跃无人）换图标——静态层 Material 按 def 缓存、换图须触发 layer 重建，不可用。
         Print override 保持空操作（动态层不经过静态层 Print）。 -->
    <useDynamicDrawer>true</useDynamicDrawer>
    <texture>World/WorldObjects/RoutePlannerWaypoint</texture>
    <!-- FormCaravanComp（2026-08）：原版"重组远行队"按钮的挂载条件——WorldGizmoUtility.TryGetCaravanGizmo
         要求 tile 上的 MapParent GetComponent<FormCaravanComp>() != null，缺 comp 时选中地块只剩
         "Send caravan to tile"。非家园图（IsPlayerHome=false）自动走 Reform 分支（Dialog_FormCaravan
         reform:true），自带敌人/精神状态门控；出口查找由 Patches_RCellFinder.TryFindClosestEdgeCellTo
         重定向到传送点 → 组队离场成远行队。 -->
    <comps>
      <li Class="RimWorld.WorldObjectCompProperties_FormCaravan"/>
    </comps>
  </WorldObjectDef>

</Defs>
