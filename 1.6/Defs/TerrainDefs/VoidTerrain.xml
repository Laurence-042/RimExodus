<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		六边形/五边形裁切用的"虚空"地形。放在多边形可活动区域之外的格子。
		不继承 NaturalTerrainBase，避免带入太空边框贴图等无关默认值（参考 VMF ImpassableFloor 的独立顶级定义）。

		不可通行保证（经源码调研确认，无需额外 Harmony patch）：
		- passability=Impassable：PathGrid 返回 10000，寻路/Region/JumpUtility.ValidJumpTarget 全部拒绝。
		- 不设 forcePassableByFlyingPawns（保持默认 false）：Flying PathGrid 也判为不可通行，堵住飞行漏洞。
		- fertility=0：WildPlantSpawner 不在此生植物。
		- 空 affordances：任何需要地形承载面的建筑都无法放置。
		- changeable=false + layerable=false：玩家无法用铺地板/地形改造覆盖。
		- holdSnowOrSand=false：不积雪沙。
		- filthAcceptanceMask=None：不生污物。
		- avoidWander=true：wander AI 不选此格（额外保险）。
		- dontRender=true：主地形层不绘制（用 ShadowMask 材质，透明/暗影）。

		渲染说明（阶段4a 游戏内确认）：
		- dontRender=true 时 SectionLayer_Terrain 用 ShadowMask（透明），不画 BadGraphic。
		- 但移动相机时，之前显示正常地形的位置若变为 void，因没有新内容写入颜色缓冲，
		  会保留上一帧的残影（正常地形像素），多次叠加后呈现红色。这是渲染管线未清色缓冲的问题，
		  需在 SeamlessTileRenderer/Patch_MapEdgeClipDrawer 处理，不能靠 TerrainDef 改动解决。
	-->
	<TerrainDef>
		<defName>RimExodus_Void</defName>
		<label>void</label>
		<description>Seamless tile boundary void. Impassable, transparent, non-buildable.</description>
		<dontRender>true</dontRender>
		<!-- texturePath 必须有值（2026-08-29 Dubs Mint Minimap 崩溃修复）：TerrainDef.texturePath 无默认值、
		     不写即 null —— 第三方读地形贴图的 mod（Dubs Blitter 的 def.texturePath.Length）会 NRE，
		     且异常发生在 Root.OnGUI 中会打断整帧 UI 绘制。dontRender=true 下游戏内渲染不消费此贴图，
		     仅作小地图等第三方取色用（近黑 = void 语义）。 -->
		<texturePath>Void</texturePath>
		<fertility>0</fertility>
		<passability>Impassable</passability>
		<pathCost>300</pathCost>
		<holdSnowOrSand>false</holdSnowOrSand>
		<changeable>false</changeable>
		<layerable>false</layerable>
		<avoidWander>true</avoidWander>
		<affordances>
		</affordances>
		<filthAcceptanceMask>
			<li>None</li>
		</filthAcceptanceMask>
	</TerrainDef>

</Defs>
