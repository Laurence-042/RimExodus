<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!--
		六边形/五边形裁切用的"虚空"地形。放在多边形可活动区域之外的格子。
		不继承 NaturalTerrainBase，避免带入太空边框贴图等无关默认值（参考 VMF_ImpassableFloor 的独立顶级定义）。

		不可通行保证（经源码调研确认，无需额外 Harmony patch）：
		- passability=Impassable：PathGrid 返回 10000，寻路/Region/JumpUtility.ValidJumpTarget 全部拒绝。
		- 不设 forcePassableByFlyingPawns（保持默认 false）：Flying PathGrid 也判为不可通行，堵住飞行漏洞。
		- fertility=0：WildPlantSpawner 不在此生植物。
		- 空 affordances：任何需要地形承载面的建筑都无法放置。
		- changeable=false + layerable=false：玩家无法用铺地板/地形改造覆盖。
		- holdSnowOrSand=false：不积雪沙。
		- filthAcceptanceMask=None：不生污物。
		- avoidWander=true：wander AI 不选此格（额外保险）。
		- dontRender=true：透明，不绘制（两地图重叠带由透明性消除视觉冲突）。
	-->
	<TerrainDef>
		<defName>RimExodus_Void</defName>
		<label>void</label>
		<description>Seamless tile boundary void. Impassable, transparent, non-buildable.</description>
		<dontRender>true</dontRender>
		<fertility>0</fertility>
		<passability>Impassable</passability>
		<pathCost>300</pathCost>
		<holdSnowOrSand>false</holdSnowOrSand>
		<changeable>false</changeable>
		<layerable>false</layerable>
		<avoidWander>true</avoidWander>
		<affordances>
		</affordances>
		<filthAcceptanceMask>
			<li>None</li>
		</filthAcceptanceMask>
	</TerrainDef>

</Defs>
